{
  "name": "@dtsgenerator/create",
  "version": "2.0.0",
  "description": "This repository is the create command for dtsgenerator plugin.",
  "main": "./bin/create.js",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create": "./bin/create.js"
  },
  "scripts": {
    "format": "prettier --check src/*.ts test/*.js",
    "format:fix": "prettier --write src/*.ts test/*.js",
    "lint": "eslint src/*.ts",
    "lint:fix": "eslint --fix src/*.ts",
    "fix": "npm run format:fix && npm run lint:fix",
    "compile": "tsc -p .",
    "build": "npm run compile",
    "test": "npm run compile && node --test test/*.test.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dtsgenerator/create.git"
  },
  "keywords": [
    "dtsgenerator"
  ],
  "author": "horiuchi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dtsgenerator/create/issues"
  },
  "homepage": "https://github.com/dtsgenerator/create#readme",
  "dependencies": {
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "fs-extra": "^11.4.0",
    "mustache": "^4.2.0",
    "tslib": "^2.8.1",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@dtsgenerator/eslint-config": "^1.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.20.1",
    "@types/validate-npm-package-name": "^4.0.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "src/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
